{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-paper 5.0 common task packet — version 1",
  "description": "Versioned transport contract. Original v009/v012 source policies, budgets, output schemas and gates remain authoritative. No execution permission or evidence authentication is implied. C03–C05 implement run binding, input freeze and executor integration.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Required explicit wire version; missing/unsupported versions are rejected, never silently upgraded."
    },
    "research_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "search_levels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Original authorized search layers; empty for non-search tasks. Do not infer authorization."
    },
    "input_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      },
      "description": "Input paths and SHA-256 values; runtime binding and freeze checks are subsequent tasks."
    },
    "source_scope": {
      "type": "object",
      "properties": {
        "journals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "policy_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      },
      "description": "Authorized source restrictions from original policy; optional nested fields may be omitted when inapplicable, never interpreted as permission or expanded scope.",
      "additionalProperties": false
    },
    "quantity_budget": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Named original workload limits, e.g. target, max_batches, native_search_actions; zero is valid. Explicit required value; absence is invalid, and an empty object provides no positive budget."
    },
    "time_budget_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Explicit seconds; no default. Zero is valid and does not grant a positive runtime."
    },
    "output_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "file"
            },
            "file": {
              "$ref": "#/$defs/file"
            }
          },
          "required": [
            "kind",
            "file"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "inline"
            },
            "schema": {
              "type": "object"
            }
          },
          "required": [
            "kind",
            "schema"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Original output contract, as a locked file reference or inline schema."
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Optional explanatory notes only; omission means no notes, never authorization."
    }
  },
  "required": [
    "schema_version",
    "research_id",
    "stage_id",
    "task_id",
    "purpose",
    "research_question",
    "search_levels",
    "input_files",
    "source_scope",
    "quantity_budget",
    "time_budget_seconds",
    "output_schema",
    "stop_conditions"
  ],
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
