{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-paper unified result bundle, C12",
  "description": "Transport only: identities, distinct provenance, action/source claims and explicit missing evidence. Original receivers decide actual academic eligibility.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "task_snapshot": {
      "type": "object",
      "properties": {
        "research_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "research_id",
        "stage_id",
        "task_id",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "executor": {
      "enum": [
        "chat_native_web",
        "codex_cli",
        "manual"
      ]
    },
    "provenance": {
      "oneOf": [
        {
          "$ref": "#/$defs/chat_provenance"
        },
        {
          "$ref": "#/$defs/codex_provenance"
        },
        {
          "$ref": "#/$defs/manual_provenance"
        }
      ]
    },
    "execution_time": {
      "type": "object",
      "properties": {
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        }
      },
      "required": [
        "started_at",
        "finished_at"
      ],
      "additionalProperties": false
    },
    "search_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search_action"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "failure_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_status": {
      "enum": [
        "not_executed",
        "unknown",
        "no_results",
        "partial_results",
        "completed",
        "failed"
      ]
    },
    "execution_issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution_issue"
      }
    }
  },
  "required": [
    "schema_version",
    "task_snapshot",
    "executor",
    "provenance",
    "execution_time",
    "search_actions",
    "sources",
    "failure_reasons",
    "execution_status",
    "execution_issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "executor": {
            "const": "chat_native_web"
          }
        },
        "required": [
          "executor"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "$ref": "#/$defs/chat_provenance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "const": "codex_cli"
          }
        },
        "required": [
          "executor"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "$ref": "#/$defs/codex_provenance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executor": {
            "const": "manual"
          }
        },
        "required": [
          "executor"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "$ref": "#/$defs/manual_provenance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "not_executed",
              "no_results"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "partial_results"
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          },
          "execution_issues": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "execution_issues": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "no_results"
          }
        }
      },
      "then": {
        "properties": {
          "execution_issues": {
            "contains": {
              "type": "object",
              "properties": {
                "code": {
                  "const": "no_results"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "execution_issues": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "scope": {
                    "const": "run"
                  },
                  "code": {
                    "enum": [
                      "no_results",
                      "partial_results",
                      "timeout",
                      "budget_exhausted",
                      "login_failed",
                      "permission_denied",
                      "tool_unavailable"
                    ]
                  }
                },
                "required": [
                  "scope",
                  "code"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "chat_provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "chat_native_web"
        },
        "record_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "citation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "record_refs",
        "citation_refs",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "codex_provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "codex_cli"
        },
        "command": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "events": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "prompt": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "login": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_record": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual independently captured invocation record; never reconstruct from a command template."
        }
      },
      "required": [
        "kind",
        "command",
        "thread_id",
        "exit_code",
        "events",
        "response",
        "stderr",
        "prompt",
        "schema",
        "login",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "manual_provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "manual"
        },
        "submitter": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "submitted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "source_type": {
          "enum": [
            "uploaded_file",
            "public_url",
            "interview_transcript",
            "manual_excerpt",
            "other"
          ]
        },
        "verification_status": {
          "enum": [
            "unverified",
            "pending",
            "verified",
            "rejected"
          ]
        },
        "original_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "submitter",
        "submitted_at",
        "source_type",
        "verification_status",
        "original_files",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "search_action": {
      "type": "object",
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "enum": [
            "search",
            "open_page",
            "find_in_page",
            "other"
          ]
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        },
        "query": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "original_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "record_locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "action_id",
        "action_type",
        "occurred_at",
        "query",
        "original_url",
        "record_locator",
        "source_ids",
        "failure_reason"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "literature",
            "empirical",
            "other"
          ]
        },
        "original_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "metadata_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "abstract_url": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publication": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "abstract_locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "open_status": {
          "enum": [
            "opened",
            "not_opened",
            "unknown"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "paraphrase": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "relevance_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "dedup_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failure_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "literature_stages": {
          "oneOf": [
            {
              "$ref": "#/$defs/literature_stages"
            },
            {
              "type": "null"
            }
          ]
        },
        "empirical_material": {
          "oneOf": [
            {
              "$ref": "#/$defs/empirical_material"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_id",
        "source_type",
        "original_url",
        "metadata_url",
        "abstract_url",
        "title",
        "authors",
        "publication",
        "publication_date",
        "doi",
        "abstract_locator",
        "open_status",
        "excerpt",
        "paraphrase",
        "relevance_reason",
        "dedup_key",
        "limits",
        "failure_reasons",
        "action_ids",
        "literature_stages",
        "empirical_material"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "literature"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "literature_stages": {
                "$ref": "#/$defs/literature_stages"
              }
            }
          },
          "else": {
            "properties": {
              "literature_stages": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "empirical"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "empirical_material": {
                "$ref": "#/$defs/empirical_material"
              }
            }
          },
          "else": {
            "properties": {
              "empirical_material": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "literature_stages": {
      "type": "object",
      "properties": {
        "discovery_status": {
          "enum": [
            "discovered",
            "not_discovered",
            "unknown"
          ]
        },
        "abstract_read_status": {
          "enum": [
            "read",
            "not_read",
            "unknown"
          ]
        },
        "fulltext_read_status": {
          "enum": [
            "read",
            "not_read",
            "unknown"
          ]
        },
        "formal_inclusion_status": {
          "enum": [
            "pending_original_gate",
            "not_included"
          ],
          "description": "Executor submission cannot assert formal inclusion. Original gate decision belongs to a separate receiver-owned record."
        }
      },
      "required": [
        "discovery_status",
        "abstract_read_status",
        "fulltext_read_status",
        "formal_inclusion_status"
      ],
      "additionalProperties": false
    },
    "empirical_fact_candidate": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "reported",
            "needs_verification",
            "contradicted"
          ]
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "statement",
        "locator",
        "status",
        "limits"
      ],
      "additionalProperties": false
    },
    "empirical_material": {
      "type": "object",
      "properties": {
        "source_description": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "event_or_subject": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_type": {
          "enum": [
            "actor_statement",
            "reporter_account",
            "official_rule",
            "documented_action",
            "other",
            "unknown"
          ]
        },
        "context": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "collection_path": {
          "enum": [
            "secondary_interviews",
            "online_qualitative",
            "other",
            "unknown"
          ]
        },
        "access": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "verifiable_facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/empirical_fact_candidate"
          }
        },
        "researcher_interpretations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupported_judgments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "source_description",
        "event_or_subject",
        "event_date",
        "locator",
        "content_type",
        "context",
        "collection_path",
        "access",
        "verifiable_facts",
        "researcher_interpretations",
        "unsupported_judgments"
      ],
      "additionalProperties": false
    },
    "execution_issue": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "no_results",
            "partial_results",
            "abstract_missing",
            "access_failed",
            "login_wall",
            "timeout",
            "source_conflict",
            "budget_exhausted",
            "login_failed",
            "permission_denied",
            "tool_unavailable",
            "missing_record",
            "other"
          ]
        },
        "scope": {
          "enum": [
            "run",
            "source",
            "action"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "original_status": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "code",
        "scope",
        "target_id",
        "detail",
        "original_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "run"
              }
            }
          },
          "then": {
            "properties": {
              "target_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "target_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
