{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "task_snapshot": {
      "type": "object",
      "properties": {
        "research_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "stage_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "task_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "research_id",
        "stage_id",
        "task_id",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "review_kind": {
      "enum": [
        "preliminary_academic",
        "research_design",
        "qualitative_design",
        "final_research",
        "event_fact",
        "critical_exchange",
        "empirical_matrix",
        "material_adequacy",
        "writing_plan",
        "qualitative_g7",
        "quantitative_g7"
      ]
    },
    "decision": {
      "enum": [
        "pass",
        "revise",
        "need_evidence",
        "reject",
        "unable_to_review"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "assessment_scope": {
      "type": "string",
      "pattern": "\\S"
    },
    "evidence_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "reviewer": {
      "oneOf": [
        {
          "$ref": "#/$defs/reviewer"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_snapshot",
    "review_kind",
    "decision",
    "reason",
    "issues",
    "assessment_scope",
    "evidence_findings",
    "reviewer",
    "execution_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D12 review result — task and execution-bound proposed decision",
  "description": "Version 3 binds review identity and an execution ID; a separately selected execution receipt binds the actual report and records. No independent or academic approval is implied.",
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "dimension_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "category": {
          "enum": [
            "academic_defect",
            "evidence_gap",
            "execution_blocker",
            "technical_defect",
            "suggestion"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "required_action": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "issue_id",
        "dimension_id",
        "category",
        "blocking",
        "detail",
        "evidence_ids",
        "required_action"
      ],
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "lines"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json_pointer"
            },
            "pointer": {
              "type": "string",
              "pattern": "^/(?:[^~]|~[01])*$"
            }
          },
          "required": [
            "kind",
            "pointer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "relation": {
          "enum": [
            "support",
            "counterexample",
            "competing",
            "context"
          ]
        },
        "support_scope": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "evidence_id",
        "artifact_id",
        "path",
        "sha256",
        "locator",
        "relation",
        "support_scope"
      ],
      "additionalProperties": false
    },
    "unresolved_question": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "pattern": "\\S"
        },
        "blocking": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "question",
        "blocking",
        "reason"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "dimension_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "claim_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "supported",
            "limited",
            "contradicted",
            "unresolved"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "scope_limit": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          },
          "uniqueItems": true
        },
        "counterexample_review": {
          "type": "string",
          "pattern": "\\S"
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolved_question"
          }
        }
      },
      "required": [
        "dimension_id",
        "claim_id",
        "status",
        "blocking",
        "reason",
        "scope_limit",
        "evidence",
        "counterexample_review",
        "unresolved_questions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "supported",
                  "limited"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "relation": {
                      "const": "support"
                    }
                  },
                  "required": [
                    "relation"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "contradicted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "contains": {
                  "properties": {
                    "relation": {
                      "const": "counterexample"
                    }
                  },
                  "required": [
                    "relation"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unresolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "unresolved_questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "blocking": {
                "const": false
              }
            },
            "required": [
              "blocking"
            ]
          },
          "then": {
            "properties": {
              "unresolved_questions": {
                "items": {
                  "properties": {
                    "blocking": {
                      "const": false
                    }
                  },
                  "required": [
                    "blocking"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "research_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "stage_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "task_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "research_id",
        "stage_id",
        "task_id",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "executor": {
          "enum": [
            "chat_native_web",
            "codex_cli",
            "manual"
          ]
        },
        "reviewer_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "model": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation_id": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "executor",
        "reviewer_id",
        "model",
        "invocation_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "executor": {
                "enum": [
                  "chat_native_web",
                  "codex_cli"
                ]
              }
            },
            "required": [
              "executor"
            ]
          },
          "then": {
            "properties": {
              "model": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "execution_record": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "response",
            "events",
            "invocation",
            "session_record",
            "manual_record",
            "prompt",
            "login",
            "stderr"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "execution_binding": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "execution_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "task_snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "report": {
          "$ref": "#/$defs/file_ref"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_record"
          }
        }
      },
      "required": [
        "schema_version",
        "execution_id",
        "task_snapshot",
        "reviewer",
        "report",
        "status",
        "records"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                },
                "category": {
                  "const": "suggestion"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "revise"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "enum": [
                    "academic_defect",
                    "technical_defect"
                  ]
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "need_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "enum": [
                    "evidence_gap"
                  ]
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "reject"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "enum": [
                    "academic_defect"
                  ]
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "unable_to_review"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "enum": [
                    "execution_blocker"
                  ]
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "pass",
              "revise",
              "reject",
              "need_evidence"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "not": {
              "contains": {
                "properties": {
                  "category": {
                    "enum": [
                      "execution_blocker"
                    ]
                  },
                  "blocking": {
                    "const": true
                  }
                },
                "required": [
                  "category",
                  "blocking"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "pass",
              "revise",
              "reject"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "not": {
              "contains": {
                "properties": {
                  "category": {
                    "enum": [
                      "evidence_gap"
                    ]
                  },
                  "blocking": {
                    "const": true
                  }
                },
                "required": [
                  "category",
                  "blocking"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_findings": {
            "minItems": 1,
            "contains": {
              "properties": {
                "status": {
                  "enum": [
                    "supported",
                    "limited"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                }
              },
              "required": [
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "need_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_findings": {
            "contains": {
              "properties": {
                "blocking": {
                  "const": true
                },
                "unresolved_questions": {
                  "contains": {
                    "properties": {
                      "blocking": {
                        "const": true
                      }
                    },
                    "required": [
                      "blocking"
                    ]
                  }
                }
              },
              "required": [
                "blocking",
                "unresolved_questions"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "pass",
              "revise",
              "need_evidence",
              "reject"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "reviewer": {
            "$ref": "#/$defs/reviewer"
          },
          "execution_id": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewer": {
            "type": "null"
          }
        },
        "required": [
          "reviewer"
        ]
      },
      "then": {
        "properties": {
          "execution_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
