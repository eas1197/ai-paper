{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D11 review result — evidence-addressable candidate decision, not gate authorization",
  "description": "Version 2 extends D10 with file-bound evidence references, claim/dimension assessments, explicit counterexample checks and unresolved questions. The receiver must still verify all IDs, paths and hashes against the frozen D09 task snapshot; this schema does not prove independent identity or authorize an original gate.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "task_snapshot": {
      "type": "object",
      "properties": {
        "research_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "stage_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "task_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "research_id",
        "stage_id",
        "task_id",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "review_kind": {
      "enum": [
        "preliminary_academic",
        "research_design",
        "qualitative_design",
        "final_research",
        "event_fact",
        "critical_exchange",
        "empirical_matrix",
        "material_adequacy",
        "writing_plan",
        "qualitative_g7",
        "quantitative_g7"
      ]
    },
    "decision": {
      "enum": [
        "pass",
        "revise",
        "need_evidence",
        "reject",
        "unable_to_review"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "assessment_scope": {
      "type": "string",
      "pattern": "\\S"
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_reference"
      },
      "uniqueItems": true
    },
    "claim_assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_assessment"
      },
      "uniqueItems": true
    },
    "dimension_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dimension_assessment"
      },
      "uniqueItems": true
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolved_question"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "task_snapshot",
    "review_kind",
    "decision",
    "reason",
    "issues",
    "assessment_scope",
    "evidence_references",
    "claim_assessments",
    "dimension_assessments",
    "unresolved_questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "locator": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "line_range",
            "page",
            "paragraph",
            "section",
            "table",
            "figure",
            "timestamp",
            "record_id",
            "url_fragment",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "counterexample_check": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "found",
            "not_found_after_review",
            "not_assessed",
            "not_applicable"
          ]
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "search_scope": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "evidence_ref_ids",
        "search_scope"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "found"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_found_after_review",
                  "not_assessed",
                  "not_applicable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "evidence_reference": {
      "type": "object",
      "properties": {
        "evidence_ref_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+\\S$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "relation": {
          "enum": [
            "supports",
            "counterexample",
            "context",
            "limits"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "dimension_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "support_scope": {
          "type": "string",
          "pattern": "\\S"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "verification_status": {
          "const": "verified_in_snapshot"
        }
      },
      "required": [
        "evidence_ref_id",
        "evidence_id",
        "artifact_id",
        "path",
        "sha256",
        "locator",
        "relation",
        "claim_ids",
        "dimension_ids",
        "support_scope",
        "limitations",
        "verification_status"
      ],
      "additionalProperties": false
    },
    "claim_assessment": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "assessment": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported",
            "contradicted",
            "not_assessed"
          ]
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "counterexample_check": {
          "$ref": "#/$defs/counterexample_check"
        },
        "support_scope": {
          "type": "string",
          "pattern": "\\S"
        },
        "unresolved_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "assessment",
        "evidence_ref_ids",
        "counterexample_check",
        "support_scope",
        "unresolved_question_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment": {
                "enum": [
                  "supported",
                  "partially_supported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "dimension_assessment": {
      "type": "object",
      "properties": {
        "dimension_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "assessment": {
          "enum": [
            "supported",
            "partially_supported",
            "unresolved",
            "not_applicable",
            "not_assessed"
          ]
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "counterexample_check": {
          "$ref": "#/$defs/counterexample_check"
        },
        "support_scope": {
          "type": "string",
          "pattern": "\\S"
        },
        "unresolved_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "dimension_id",
        "assessment",
        "evidence_ref_ids",
        "counterexample_check",
        "support_scope",
        "unresolved_question_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment": {
                "enum": [
                  "supported",
                  "partially_supported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "unresolved_question": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "dimension_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "question": {
          "type": "string",
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "needed_evidence": {
          "type": "string",
          "pattern": "\\S"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "question_id",
        "claim_ids",
        "dimension_ids",
        "question",
        "reason",
        "needed_evidence",
        "blocking"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "issue_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "dimension_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "category": {
          "enum": [
            "academic_defect",
            "evidence_gap",
            "execution_blocker",
            "technical_defect",
            "suggestion"
          ]
        },
        "blocking": {
          "type": "boolean"
        },
        "detail": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "evidence_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "counterexample_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "unresolved_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "required_action": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "issue_id",
        "dimension_id",
        "category",
        "blocking",
        "detail",
        "evidence_ids",
        "evidence_ref_ids",
        "counterexample_ref_ids",
        "unresolved_question_ids",
        "required_action"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                },
                "category": {
                  "const": "suggestion"
                }
              }
            }
          },
          "unresolved_questions": {
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                }
              }
            }
          },
          "claim_assessments": {
            "items": {
              "properties": {
                "assessment": {
                  "enum": [
                    "supported",
                    "partially_supported"
                  ]
                },
                "counterexample_check": {
                  "properties": {
                    "status": {
                      "enum": [
                        "found",
                        "not_found_after_review",
                        "not_applicable"
                      ]
                    }
                  }
                }
              }
            }
          },
          "dimension_assessments": {
            "items": {
              "properties": {
                "assessment": {
                  "enum": [
                    "supported",
                    "partially_supported",
                    "not_applicable"
                  ]
                },
                "counterexample_check": {
                  "properties": {
                    "status": {
                      "enum": [
                        "found",
                        "not_found_after_review",
                        "not_applicable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "revise"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "enum": [
                    "academic_defect",
                    "technical_defect"
                  ]
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "need_evidence"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "const": "evidence_gap"
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          },
          "unresolved_questions": {
            "contains": {
              "properties": {
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "reject"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "const": "academic_defect"
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "unable_to_review"
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {
                "category": {
                  "const": "execution_blocker"
                },
                "blocking": {
                  "const": true
                }
              },
              "required": [
                "category",
                "blocking"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "pass",
              "revise",
              "reject",
              "need_evidence"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "not": {
              "contains": {
                "properties": {
                  "category": {
                    "const": "execution_blocker"
                  },
                  "blocking": {
                    "const": true
                  }
                },
                "required": [
                  "category",
                  "blocking"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "pass",
              "revise",
              "reject"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "not": {
              "contains": {
                "properties": {
                  "category": {
                    "const": "evidence_gap"
                  },
                  "blocking": {
                    "const": true
                  }
                },
                "required": [
                  "category",
                  "blocking"
                ]
              }
            }
          }
        }
      }
    }
  ]
}