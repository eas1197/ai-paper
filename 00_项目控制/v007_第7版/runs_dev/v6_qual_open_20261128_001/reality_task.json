  "reality_task": "\u7f51\u7edc\u5b9a\u6027\u4f18\u5148\u6309\u9898\u76ee\u5728\u5c0f\u7ea2\u4e66\u3001\u8c46\u74e3\u3001\u77e5\u4e4e\u3001\u767e\u5ea6\u8d34\u5427\u3001\u5c0f\u9ed1\u76d2\u3001\u5fae\u535a\u7b49\u516c\u5f00\u5e73\u53f0\u67e5\u627e\u5f53\u4e8b\u4eba\u4eb2\u5386\u4e0e\u53d1\u8a00\uff0c\u4e5f\u53ef\u4f7f\u7528\u4e0e\u573a\u57df\u76f8\u7b26\u7684\u516c\u5f00\u5e73\u53f0\u3002\u8bb0\u5f55\u5b9e\u9645\u67e5\u8be2\u3001\u6765\u6e90\u94fe\u63a5\u3001\u539f\u6587\u4f4d\u7f6e\u548c\u8bbf\u95ee\u5931\u8d25\u3002\u533a\u5206\u5f53\u4e8b\u4eba\u81ea\u8ff0\u3001\u8f6c\u8ff0\u3001\u6838\u5b9e\u4e8b\u5b9e\u4e0e\u63a8\u65ad\uff0c\u5408\u5e76\u540c\u4e00\u4e8b\u4ef6\u7684\u8f6c\u8f7d\u3002\u5b98\u65b9\u653f\u7b56\u53ca\u88c1\u51b3\u4e3b\u8981\u8f85\u52a9\u6838\u8bc1\u89c4\u5219\u3001\u65f6\u95f4\u4e0e\u4e8b\u4ef6\uff1b\u7814\u7a76\u5236\u5ea6\u6587\u672c\u672c\u8eab\u65f6\u53ef\u4f5c\u4e3a\u76f4\u63a5\u8bc1\u636e\u3002\u7f3a\u5c11\u53ef\u6838\u9a8c\u4eb2\u5386\u6750\u6599\u65f6\u8bb0\u5f55\u7f3a\u53e3\u3002\u5148\u7528\u539f\u751f\u7f51\u9875\u641c\u7d22\u89c2\u5bdf\u65e5\u5e38\u793e\u4f1a\u751f\u6d3b\u3002\u4ece\u65b0\u95fb\u3001\u516c\u5f00\u8ba8\u8bba\u3001\u91c7\u8bbf\u3001\u8c03\u67e5\u6216\u6587\u5316\u73b0\u8c61\u6bd4\u8f83\u7ebf\u7d22\uff1b\u5b98\u65b9\u7edf\u8ba1\u4e0e\u653f\u7b56\u7528\u4e8e\u6838\u5b9e\uff0c\u4e0d\u4ee5\u653f\u7b56\u76ee\u6807\u4ee3\u66ff\u4e8b\u5b9e\u3002\u6807\u660e\u4e2a\u6848\u3001\u8206\u8bba\u3001\u8c03\u67e5\u53ca\u53ef\u63a8\u5e7f\u8303\u56f4\uff0c\u63d0\u70bc\u5f85\u89e3\u91ca\u7684\u77db\u76fe\uff0c\u518d\u628a\u63a2\u7d22\u7ebf\u7d22\u4ea4\u7ed9\u5b66\u672f\u521d\u67e5\u3002",
  "research_and_review_task": "\u4ece\u591a\u4e2a\u72ec\u7acb\u771f\u5b9e\u884c\u52a8\u4e8b\u4ef6\u51fa\u53d1\uff0c\u6bd4\u8f83\u5171\u540c\u6761\u4ef6\u3001\u884c\u52a8\u8fc7\u7a0b\u548c\u7ed3\u679c\u5dee\u5f02\uff0c\u5148\u660e\u786e\u6709\u4f9d\u636e\u7684\u9884\u671f\uff0c\u518d\u63d0\u51fa\u7814\u7a76\u95ee\u9898\u3002\u7528\u4e00\u4e2a\u6982\u5ff5\u51c6\u786e\u7684\u95ee\u53e5\u63d0\u51fa\u6838\u5fc3\u95ee\u9898\u3002\u628a\u7814\u7a76\u60c5\u5883\u3001\u673a\u5236\u3001\u5047\u8bbe\u6216\u547d\u9898\u3001\u5b9e\u8bc1\u8bbe\u8ba1\u5206\u522b\u9648\u8ff0\u3002\u4ece\u6587\u732e\u89e3\u91ca\u4e0e\u7406\u8bba\u53cd\u8bd8\u63a8\u5bfc\u9884\u671f\uff0c\u8bf4\u660e\u4f5c\u7528\u6761\u4ef6\u3001\u7ade\u4e89\u89e3\u91ca\u3001\u652f\u6301\u8bc1\u636e\u548c\u53cd\u8bc1\u3002\u63cf\u8ff0\u6027\u6216\u63a2\u7d22\u6027\u7814\u7a76\u53ef\u7528\u547d\u9898\u6216\u5b50\u95ee\u9898\u3002\u72ec\u7acb\u5ba1\u67e5\u5e94\u6838\u5bf9\u73b0\u5b9e\u6765\u6e90\u3001\u793e\u4f1a\u77db\u76fe\u3001\u95ee\u9898\u5355\u4e00\u6027\u3001\u63a8\u5bfc\u662f\u5426\u6210\u7acb\u3001\u5404\u9879\u9884\u671f\u662f\u5426\u56de\u7b54\u6838\u5fc3\u95ee\u9898\u3001\u6570\u636e\u662f\u5426\u5b9e\u9645\u53ef\u68c0\u9a8c\u3002",
  "observation_instruction": "\u4f18\u5148\u627e\u771f\u5b9e\u4e8b\u4ef6\u548c\u884c\u52a8\u8fc7\u7a0b\u3002\u89c2\u5bdf\u4e8b\u4ef6\u3001\u4e92\u52a8\u3001\u51b3\u7b56\u548c\u8ba4\u77e5\uff1b\u8fd9\u4e9b\u662f\u89c2\u5bdf\u89d2\u5ea6\uff0c\u4e0d\u662f\u8bba\u6587\u7ae0\u8282\u3002\u6bd4\u8f83\u73b0\u5b9e\u4e0e\u6709\u4f9d\u636e\u7684\u9884\u671f\uff0c\u4fdd\u7559\u8bc1\u636e\u8fb9\u754c\uff1b\u5141\u8bb8\u5177\u6709\u72ec\u7acb\u4ef7\u503c\u7684\u6b63\u5e38\u73b0\u8c61\u3002\u89e3\u91ca\u65f6\u6309\u95ee\u9898\u81ea\u7531\u9009\u62e9\u884c\u52a8\u3001\u7ed3\u6784\u6216\u7ed3\u6784\u2014\u884c\u52a8\u89c6\u89d2\u3002\u53ef\u5173\u6ce8\u8ba4\u77e5\u3001\u534f\u5546\u4e0e\u9009\u62e9\uff0c\u5236\u5ea6\u3001\u8d44\u6e90\u548c\u6743\u529b\u7ea6\u675f\uff0c\u6216\u6761\u4ef6\u4e0e\u884c\u52a8\u7684\u76f8\u4e92\u4f5c\u7528\u3002\u8bf4\u660e\u4f1a\u6539\u53d8\u7ed3\u679c\u7684\u673a\u5236\u4e0e\u7ade\u4e89\u89e3\u91ca\uff1b\u5236\u5ea6\u6761\u6587\u548c\u64cd\u4f5c\u6b65\u9aa4\u53ef\u4ee5\u4f5c\u6750\u6599\uff0c\u4f46\u5355\u51ed\u5b83\u4eec\u4e0d\u8db3\u4ee5\u89e3\u91ca\u793e\u4f1a\u7ed3\u679c\u3002",
  "critical_instruction": "\u53cd\u65b9\u8d28\u7591\u89e3\u91ca\u7684\u524d\u63d0\u3001\u627e\u53cd\u4f8b\u4e0e\u7ade\u4e89\u673a\u5236\uff0c\u53ef\u4ee5\u63d0\u51fa\u72ec\u7acb\u5019\u9009\u9898\u3002\u72ec\u7acb\u5ba1\u67e5\u53e6\u505a\u5b66\u672f\u5224\u65ad\u4e0e\u653e\u884c\u3002",
