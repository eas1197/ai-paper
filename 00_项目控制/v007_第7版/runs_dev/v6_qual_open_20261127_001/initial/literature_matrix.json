    {
      "title": "拆“穿”的家庭：住居史、再分家与边界之争货币化征迁的伦理政治化",
      "authors": [
        "林叶"
      ],
      "journal": "社会",
      "year": "2020",
      "doi": null,
      "metadata_url": "https://www.society.shu.edu.cn/CN/abstract/abstract17787.shtml",
