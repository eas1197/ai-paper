    {
      "title": "Unpolicing the Urban Poor: Consequences of Third-Party Policing for Inner-City Women",
      "authors": [
        "Matthew Desmond",
        "Nicol Valdez"
      ],
      "journal": "American Sociological Review",
      "year": "2013",
      "doi": "10.1177/0003122412470829",
      "metadata_url": "https://journals.sagepub.com/doi/abs/10.1177/0003122412470829",
