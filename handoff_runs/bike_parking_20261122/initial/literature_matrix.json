      "title": "The Invisible Cage: Workers’ Reactivity to Opaque Algorithmic Evaluations",
      "authors": [
        "Hatim A. Rahman"
      ],
      "journal": "Administrative Science Quarterly",
      "year": "2021",
      "doi": "10.1177/00018392211010118",
