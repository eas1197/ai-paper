{
  "type": "object",
  "properties": {
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "原始发表语言的论文题名；中文或英文均保留原文，不翻译后替代"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "按原刊显示保留原始拼写的单个作者姓名"
            }
          },
          "journal": {
            "type": "string",
            "description": "九刊之一的准确刊名，必须与本轮九刊白名单完全一致"
          },
          "year": {
            "type": "integer"
          },
          "doi": {
            "type": "string",
            "description": "明确出现的 DOI 或空字符串"
          },
          "metadata_url": {
            "type": "string",
            "description": "本次工具结果中的题录 HTTPS URL"
          },
          "abstract_url": {
            "type": "string",
            "description": "本次工具实际看过摘要的 HTTPS URL"
          },
          "abstract_locator": {
            "type": "string",
            "description": "摘要段落、提要或原刊第一页"
          },
          "abstract_excerpt": {
            "type": "string",
            "description": "原摘要中的原文短摘并保留原始语言；中文约8至45字，英文约5至12词，整体长度8至90字符"
          },
          "abstract_summary": {
            "type": "string",
            "description": "根据原摘要撰写的中文改述，80至160字，概括方法、对象和关键结果"
          },
          "relevance": {
            "type": "string",
            "enum": [
              "direct",
              "substantive"
            ]
          },
          "relevance_reason": {
            "type": "string",
            "description": "说明研究中的分流路径或机制"
          }
        },
        "required": [
          "title",
          "authors",
          "journal",
          "year",
          "doi",
          "metadata_url",
          "abstract_url",
          "abstract_locator",
          "abstract_excerpt",
          "abstract_summary",
          "relevance",
          "relevance_reason"
        ],
        "additionalProperties": false
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "候选论文原始语言题名"
          },
          "reason": {
            "type": "string",
            "description": "未纳入原因"
          }
        },
        "required": [
          "title",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "search_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "记录实际使用的中文或英文检索词、结果驱动的改写、检索来源和局限"
      }
    }
  },
  "required": [
    "papers",
    "unverified",
    "search_notes"
  ],
  "additionalProperties": false
}
