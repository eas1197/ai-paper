          "$ref": "#/$defs/text"
        },
        "kind": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "url_or_path": {
          "$ref": "#/$defs/text"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
